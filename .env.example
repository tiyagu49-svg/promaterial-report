# Copy to .env (in this folder or the repo root) and fill in.
# Do not commit real secrets.

# --- HKGAI (our team key) ---
LLM_BASE_URL=https://api1.hkgai.net
LLM_API_KEY=your-key-here
LLM_MODEL=t2_hkgai-v3_fp8_1m_e7
# (other model id listed by /v1/models: HKGAI-V3)

# --- or DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# The client appends /v1 automatically.
# Optional: set to "mock" to run without network/API key (unit tests, offline dev)
# LLM_PROVIDER=mock

# Optional: used by the git tool (Member 3 - JI Guangning)
# GITHUB_TOKEN=
